{
  "uid": "srv6-lab",
  "title": "SRv6 лаба: трафик по интерфейсам",
  "description": "Скорость по интерфейсам всех узлов лабы: сборщик считает её сам раз в 20 мс и пишет готовой. Сборщик: te/monitoring/collector/collector.py.",
  "tags": [
    "srv6"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Узел",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "query": {
          "query": "label_values(lab_if_tx_bps, node)",
          "refId": "node"
        },
        "definition": "label_values(lab_if_tx_bps, node)",
        "regex": "/^(p[0-9]+|pe[0-9]+)$/",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Линки ядра: передача",
      "description": "Скорость с интерфейса узла в сторону соседа. Каждое направление линка — отдельная линия. Приблизьте момент отказа: точки идут раз в 20 мс.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "interval": "20ms",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (node, peer) (avg_over_time(lab_if_tx_bps{node=~\"$node\", node=~\"p[0-9]+|pe[0-9]+\", peer=~\"p[0-9]+|pe[0-9]+\"}[$__rate_interval]))",
          "legendFormat": "{{node}} → {{peer}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true,
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Потери между хостами, пакетов/с",
      "description": "Сколько пакетов в секунду отправитель выпустил и получатель не принял. В установившемся режиме около нуля, во время перестроения — всплеск. Площадь всплеска — число потерянных пакетов.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "interval": "20ms",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum(avg_over_time(lab_if_tx_pps{node=\"h1\", iface=\"eth1\"}[$__rate_interval])) - sum(avg_over_time(lab_if_rx_pps{node=\"h2\", iface=\"eth1\"}[$__rate_interval]))",
          "legendFormat": "h1 → h2",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum(avg_over_time(lab_if_tx_pps{node=\"h2\", iface=\"eth1\"}[$__rate_interval])) - sum(avg_over_time(lab_if_rx_pps{node=\"h1\", iface=\"eth1\"}[$__rate_interval]))",
          "legendFormat": "h2 → h1",
          "refId": "B",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Хосты: отправлено и получено",
      "description": "Трафик iperf на интерфейсах хостов. Провал у получателя при ровной линии отправителя — потери в сети.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "interval": "20ms",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (node) (avg_over_time(lab_if_tx_bps{node=~\"h[0-9]+\", iface=\"eth1\"}[$__rate_interval]))",
          "legendFormat": "{{node}} отправил",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (node) (avg_over_time(lab_if_rx_bps{node=~\"h[0-9]+\", iface=\"eth1\"}[$__rate_interval]))",
          "legendFormat": "{{node}} получил",
          "refId": "B",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Стыки CE — PE",
      "description": "Через какой PE трафик входит в ядро и выходит из него.",
