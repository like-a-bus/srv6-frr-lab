          "expr": "sum by (node, peer) (avg_over_time(lab_if_tx_pps{node=~\"$node\", node=~\"p[0-9]+|pe[0-9]+\", peer=~\"p[0-9]+|pe[0-9]+\"}[$__rate_interval]))",
          "legendFormat": "{{node}} → {{peer}}",
